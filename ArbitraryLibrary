local UI = {}
UI.__index = UI

local UIS = game:GetService("UserInputService")

local purple = Color3.fromRGB(128, 0, 255)
local black = Color3.fromRGB(0, 0, 0)
local white = Color3.fromRGB(255, 255, 255)

function UI.new(options)
	options = options or {}

	local self = setmetatable({}, UI)

	local gui = Instance.new("ScreenGui")
	gui.Name = options.Name or "ScreenGui"
	gui.ResetOnSpawn = false
	gui.Parent = gethui()

	self.Gui = gui
	self.Tabs = {}

	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = options.Size or UDim2.fromOffset(620, 390)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.BackgroundColor3 = black
	main.BorderColor3 = purple
	main.BorderSizePixel = 3
	main.Parent = gui

	self.Main = main

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -70, 0, 28)
	title.BackgroundColor3 = black
	title.BorderColor3 = purple
	title.BorderSizePixel = 3
	title.Text = options.Title or "Polaria"
	title.TextColor3 = white
	title.Font = Enum.Font.Code
	title.TextSize = 18
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = main

	local titlePadding = Instance.new("UIPadding")
	titlePadding.PaddingLeft = UDim.new(0, 8)
	titlePadding.Parent = title

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.Size = UDim2.fromOffset(28, 28)
	close.Position = UDim2.new(1, -28, 0, 0)
	close.BackgroundColor3 = black
	close.BorderColor3 = purple
	close.BorderSizePixel = 3
	close.Text = "X"
	close.TextColor3 = white
	close.Font = Enum.Font.Code
	close.TextSize = 16
	close.Parent = main

	local minimize = Instance.new("TextButton")
	minimize.Name = "Minimize"
	minimize.Size = UDim2.fromOffset(28, 28)
	minimize.Position = UDim2.new(1, -56, 0, 0)
	minimize.BackgroundColor3 = black
	minimize.BorderColor3 = purple
	minimize.BorderSizePixel = 3
	minimize.Text = "-"
	minimize.TextColor3 = white
	minimize.Font = Enum.Font.Code
	minimize.TextSize = 16
	minimize.Parent = main

	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.Size = UDim2.new(1, -10, 0, 22)
	subtitle.Position = UDim2.fromOffset(5, 34)
	subtitle.BackgroundTransparency = 1
	subtitle.Text = options.Subtitle or ""
	subtitle.TextColor3 = white
	subtitle.Font = Enum.Font.Code
	subtitle.TextSize = 13
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.Parent = main

	local tabs = Instance.new("Frame")
	tabs.Name = "Tabs"
	tabs.Size = UDim2.new(0, 145, 1, -70)
	tabs.Position = UDim2.fromOffset(5, 60)
	tabs.BackgroundColor3 = black
	tabs.BorderColor3 = purple
	tabs.BorderSizePixel = 3
	tabs.Parent = main

	local tabsPadding = Instance.new("UIPadding")
	tabsPadding.PaddingTop = UDim.new(0, 5)
	tabsPadding.PaddingLeft = UDim.new(0, 5)
	tabsPadding.PaddingRight = UDim.new(0, 5)
	tabsPadding.Parent = tabs

	local tabsLayout = Instance.new("UIListLayout")
	tabsLayout.Padding = UDim.new(0, 4)
	tabsLayout.Parent = tabs

	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -160, 1, -70)
	content.Position = UDim2.fromOffset(155, 60)
	content.BackgroundColor3 = black
	content.BorderColor3 = purple
	content.BorderSizePixel = 3
	content.ScrollBarThickness = 3
	content.ScrollBarImageColor3 = purple
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.Parent = main

	local contentPadding = Instance.new("UIPadding")
	contentPadding.PaddingTop = UDim.new(0, 5)
	contentPadding.PaddingBottom = UDim.new(0, 5)
	contentPadding.PaddingLeft = UDim.new(0, 5)
	contentPadding.PaddingRight = UDim.new(0, 5)
	contentPadding.Parent = content

	local contentLayout = Instance.new("UIListLayout")
	contentLayout.Padding = UDim.new(0, 5)
	contentLayout.Parent = content

	self.TabsFrame = tabs
	self.Content = content

	local minimized = Instance.new("TextButton")
	minimized.Size = UDim2.fromOffset(55, 55)
	minimized.BackgroundColor3 = black
	minimized.BorderColor3 = purple
	minimized.BorderSizePixel = 3
	minimized.Text = string.sub(title.Text, 1, 1)
	minimized.TextColor3 = white
	minimized.Font = Enum.Font.Code
	minimized.TextSize = 20
	minimized.Visible = false
	minimized.Parent = gui

	local savedPosition = main.Position

	minimize.MouseButton1Click:Connect(function()
		savedPosition = main.Position
		main.Visible = false
		minimized.Position = savedPosition
		minimized.Visible = true
	end)

	minimized.MouseButton1Click:Connect(function()
		minimized.Visible = false
		main.Position = savedPosition
		main.Visible = true
	end)

	close.MouseButton1Click:Connect(function()
		self:Destroy()
	end)

	local dragging
	local dragStart
	local startPosition

	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = main.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return self
end

function UI:Tab(name)
	local tab = {
		Name = name,
		Options = {},
		Library = self
	}

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 32)
	button.BackgroundColor3 = black
	button.BorderColor3 = purple
	button.BorderSizePixel = 2
	button.Text = name
	button.TextColor3 = white
	button.Font = Enum.Font.Code
	button.TextSize = 14
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.AutoButtonColor = false
	button.Parent = self.TabsFrame

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.Parent = button

	button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	tab.Button = button
	table.insert(self.Tabs, tab)

	if not self.ActiveTab then
		self:SelectTab(tab)
	end

	function tab:Option(text, callback)
		local option = Instance.new("TextButton")
		option.Size = UDim2.new(1, 0, 0, 32)
		option.AutomaticSize = Enum.AutomaticSize.Y
		option.BackgroundColor3 = black
		option.BorderColor3 = purple
		option.BorderSizePixel = 2
		option.Text = text
		option.TextColor3 = white
		option.Font = Enum.Font.Code
		option.TextSize = 14
		option.TextXAlignment = Enum.TextXAlignment.Left
		option.AutoButtonColor = false
		option.Visible = false
		option.Parent = self.Library.Content

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 8)
		padding.PaddingTop = UDim.new(0, 6)
		padding.PaddingBottom = UDim.new(0, 6)
		padding.Parent = option

		option.MouseButton1Click:Connect(function()
			if callback then
				callback(option)
			end
		end)

		table.insert(tab.Options, option)

		return option
	end

	return tab
end

function UI:SelectTab(tab)
	self.ActiveTab = tab

	for _, current in ipairs(self.Tabs) do
		local active = current == tab

		current.Button.BackgroundColor3 = active
			and Color3.fromRGB(30, 0, 45)
			or black

		for _, option in ipairs(current.Options) do
			option.Visible = active
		end
	end
end

function UI:Destroy()
	if self.Gui then
		self.Gui:Destroy()
	end
end

return UI
