local UI = {}

local UserInputService = game:GetService("UserInputService")

UI.__index = UI

function UI.new(settings)
	settings = settings or {}

	local self = setmetatable({}, UI)

	local gui = Instance.new("ScreenGui")
	gui.Name = settings.Name or "ScreenGui"
	gui.ResetOnSpawn = false
	gui.Parent = gethui()

	self.Gui = gui
	self.Tabs = {}

	local main = Instance.new("Frame")
	main.Size = settings.Size or UDim2.fromOffset(620, 390)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.BackgroundColor3 = Color3.fromRGB(9, 11, 17)
	main.BorderSizePixel = 0
	main.Parent = gui

	self.Main = main

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(35, 80, 145)
	stroke.Transparency = 0.45
	stroke.Parent = main

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 64)
	header.BackgroundColor3 = Color3.fromRGB(12, 15, 23)
	header.BorderSizePixel = 0
	header.Parent = main

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -130, 0, 25)
	title.Position = UDim2.fromOffset(18, 8)
	title.BackgroundTransparency = 1
	title.Text = settings.Title or "Polaria"
	title.TextColor3 = Color3.fromRGB(225, 230, 240)
	title.TextSize = 19
	title.Font = Enum.Font.GothamSemibold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = header

	local subtitle = Instance.new("TextLabel")
	subtitle.Size = UDim2.new(1, -130, 0, 18)
	subtitle.Position = UDim2.fromOffset(19, 34)
	subtitle.BackgroundTransparency = 1
	subtitle.Text = settings.Subtitle or "Universal Interface"
	subtitle.TextColor3 = Color3.fromRGB(105, 115, 135)
	subtitle.TextSize = 11
	subtitle.Font = Enum.Font.Gotham
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.Parent = header

	local minimize = Instance.new("TextButton")
	minimize.Size = UDim2.fromOffset(32, 32)
	minimize.Position = UDim2.new(1, -72, 0, 16)
	minimize.BackgroundTransparency = 1
	minimize.Text = "−"
	minimize.TextColor3 = Color3.fromRGB(150, 160, 180)
	minimize.TextSize = 22
	minimize.Font = Enum.Font.GothamMedium
	minimize.BorderSizePixel = 0
	minimize.Parent = header

	local close = Instance.new("TextButton")
	close.Size = UDim2.fromOffset(32, 32)
	close.Position = UDim2.new(1, -38, 0, 16)
	close.BackgroundTransparency = 1
	close.Text = "×"
	close.TextColor3 = Color3.fromRGB(150, 160, 180)
	close.TextSize = 21
	close.Font = Enum.Font.GothamMedium
	close.BorderSizePixel = 0
	close.Parent = header

	local sidebar = Instance.new("Frame")
	sidebar.Size = UDim2.new(0, 150, 1, -74)
	sidebar.Position = UDim2.fromOffset(10, 72)
	sidebar.BackgroundColor3 = Color3.fromRGB(11, 14, 21)
	sidebar.BorderSizePixel = 0
	sidebar.Parent = main

	local sidebarPadding = Instance.new("UIPadding")
	sidebarPadding.PaddingTop = UDim.new(0, 10)
	sidebarPadding.PaddingLeft = UDim.new(0, 8)
	sidebarPadding.PaddingRight = UDim.new(0, 8)
	sidebarPadding.Parent = sidebar

	local sidebarList = Instance.new("UIListLayout")
	sidebarList.Padding = UDim.new(0, 5)
	sidebarList.SortOrder = Enum.SortOrder.LayoutOrder
	sidebarList.Parent = sidebar

	local content = Instance.new("ScrollingFrame")
	content.Size = UDim2.new(1, -170, 1, -74)
	content.Position = UDim2.fromOffset(160, 72)
	content.BackgroundColor3 = Color3.fromRGB(11, 14, 21)
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 2
	content.ScrollBarImageColor3 = Color3.fromRGB(50, 110, 210)
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.Parent = main

	local contentPadding = Instance.new("UIPadding")
	contentPadding.PaddingTop = UDim.new(0, 12)
	contentPadding.PaddingBottom = UDim.new(0, 12)
	contentPadding.PaddingLeft = UDim.new(0, 12)
	contentPadding.PaddingRight = UDim.new(0, 12)
	contentPadding.Parent = content

	local contentList = Instance.new("UIListLayout")
	contentList.Padding = UDim.new(0, 7)
	contentList.SortOrder = Enum.SortOrder.LayoutOrder
	contentList.Parent = content

	self.Sidebar = sidebar
	self.Content = content

	local circle = Instance.new("TextButton")
	circle.Size = UDim2.fromOffset(55, 55)
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.BackgroundColor3 = Color3.fromRGB(10, 15, 25)
	circle.Text = string.sub(title.Text, 1, 1):upper()
	circle.TextColor3 = Color3.fromRGB(70, 145, 255)
	circle.TextSize = 20
	circle.Font = Enum.Font.GothamBold
	circle.BorderSizePixel = 0
	circle.Visible = false
	circle.Parent = gui

	local circleCorner = Instance.new("UICorner")
	circleCorner.CornerRadius = UDim.new(1, 0)
	circleCorner.Parent = circle

	local circleStroke = Instance.new("UIStroke")
	circleStroke.Color = Color3.fromRGB(35, 100, 190)
	circleStroke.Transparency = 0.2
	circleStroke.Parent = circle

	local savedPosition = main.Position

	minimize.MouseButton1Click:Connect(function()
		savedPosition = main.Position
		main.Visible = false
		circle.Position = savedPosition
		circle.Visible = true
	end)

	circle.MouseButton1Click:Connect(function()
		circle.Visible = false
		main.Position = savedPosition
		main.Visible = true
	end)

	close.MouseButton1Click:Connect(function()
		self:Destroy()
	end)

	local dragging = false
	local dragStart
	local startPosition

	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = main.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	return self
end

function UI:Tab(name)
	local tab = {
		Name = name,
		Options = {},
		Library = self
	}

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 38)
	button.BackgroundColor3 = Color3.fromRGB(15, 18, 27)
	button.Text = name
	button.TextColor3 = Color3.fromRGB(145, 152, 168)
	button.TextSize = 12
	button.Font = Enum.Font.GothamMedium
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Parent = self.Sidebar

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 12)
	padding.Parent = button

	tab.Button = button

	button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	table.insert(self.Tabs, tab)

	if not self.ActiveTab then
		self:SelectTab(tab)
	end

	function tab:Option(text, callback)
		local option = Instance.new("TextButton")
		option.AutomaticSize = Enum.AutomaticSize.Y
		option.Size = UDim2.new(1, 0, 0, 0)
		option.BackgroundColor3 = Color3.fromRGB(15, 19, 29)
		option.Text = text
		option.TextColor3 = Color3.fromRGB(205, 210, 220)
		option.TextSize = 12
		option.Font = Enum.Font.GothamMedium
		option.TextXAlignment = Enum.TextXAlignment.Left
		option.BorderSizePixel = 0
		option.AutoButtonColor = false
		option.Visible = false
		option.Parent = self.Library.Content

		local optionPadding = Instance.new("UIPadding")
		optionPadding.PaddingTop = UDim.new(0, 12)
		optionPadding.PaddingBottom = UDim.new(0, 12)
		optionPadding.PaddingLeft = UDim.new(0, 13)
		optionPadding.PaddingRight = UDim.new(0, 13)
		optionPadding.Parent = option

		option.MouseButton1Click:Connect(function()
			if callback then
				callback(option)
			end
		end)

		table.insert(tab.Options, option)

		return option
	end

	return tab
end

function UI:SelectTab(tab)
	self.ActiveTab = tab

	for _, current in ipairs(self.Tabs) do
		local active = current == tab

		current.Button.BackgroundColor3 = active
			and Color3.fromRGB(28, 78, 145)
			or Color3.fromRGB(15, 18, 27)

		current.Button.TextColor3 = active
			and Color3.fromRGB(235, 240, 250)
			or Color3.fromRGB(145, 152, 168)

		for _, option in ipairs(current.Options) do
			option.Visible = active
		end
	end
end

function UI:Destroy()
	if self.Gui then
		self.Gui:Destroy()
	end
end

return UI
