local InternalDeX = {}
InternalDeX.__index = InternalDeX

local function createInstance(className, properties, parent)
    local instance = Instance.new(className)
    if properties then
        for prop, val in pairs(properties) do
            instance[prop] = val
        end
    end
    if parent then
        instance.Parent = parent
    end
    return instance
end

local function Add(instancename, parent, assetid)
    local inst = Instance.new(instancename)
    
    if assetid then
        local idStr = typeof(assetid) == "number" and ("rbxassetid://" .. tostring(assetid)) or tostring(assetid)
        if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
            inst.Image = idStr
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            inst.Texture = idStr
        elseif inst:IsA("SpecialMesh") then
            inst.MeshId = idStr
        elseif inst:IsA("Sound") then
            inst.SoundId = idStr
        end
    end

    if parent then
        inst.Parent = parent
    end

    return inst
end

local function Write(instancepath, propertiesTable)
    assert(instancepath and typeof(instancepath) == "Instance", "Invalid Instance")
    assert(type(propertiesTable) == "table", "Expected table")

    for prop, val in pairs(propertiesTable) do
        pcall(function()
            instancepath[prop] = val
        end)
    end
    return instancepath
end

local function AddMulti(instancepath, returnedtable)
    assert(instancepath and typeof(instancepath) == "Instance", "Invalid Instance")
    assert(type(returnedtable) == "table", "Expected table")

    local created = {}
    for _, item in ipairs(returnedtable) do
        local className = item.Class or item.ClassName or item[1]
        local props = item.Props or item.Properties or item[2]
        local assetId = item.AssetId or item.Icon or item[3]

        if className then
            local newInst = Add(className, instancepath, assetId)
            if props and type(props) == "table" then
                Write(newInst, props)
            end
            table.insert(created, newInst)
        end
    end
    return created
end

