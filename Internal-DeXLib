function InternalDeX:AddNode(targetInstance, indentLevel, iconAssetId)
    indentLevel = indentLevel or 0
    local name = targetInstance and targetInstance.Name or "Nil"

    local nodeBtn = createInstance("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundColor3 = Color3.fromRGB(10, 20, 35),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Text = string.rep("  ", indentLevel) .. " 🔹 " .. name,
        TextColor3 = Color3.fromRGB(200, 225, 255),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSans,
        TextSize = 13
    }, self.ExplorerScroll)

    if iconAssetId then
        local icon = Add("ImageLabel", nodeBtn, iconAssetId)
        Write(icon, {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, (indentLevel * 10) + 2, 0.5, -7),
            BackgroundTransparency = 1
        })
    end

    table.insert(self.NodeCache, {Button = nodeBtn, Instance = targetInstance})

    nodeBtn.MouseButton1Click:Connect(function()
        self:RenderProperties(targetInstance)
    end)

    return nodeBtn
end

function InternalDeX:FilterNodes(query)
    query = string.lower(query)
    for _, nodeData in ipairs(self.NodeCache) do
        if query == "" or string.find(string.lower(nodeData.Instance.Name), query) then
            nodeData.Button.Visible = true
        else
            nodeData.Button.Visible = false
        end
    end
end

function InternalDeX:RenderProperties(target)
    for _, child in ipairs(self.PropertiesScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if not target then return end

    local displayProps = {
        {"Name", target.Name},
        {"ClassName", target.ClassName},
        {"Parent", target.Parent and target.Parent.Name or "nil"}
    }

    if target:IsA("BasePart") then
        table.insert(displayProps, {"Anchored", tostring(target.Anchored)})
        table.insert(displayProps, {"CanCollide", tostring(target.CanCollide)})
        table.insert(displayProps, {"Transparency", tostring(target.Transparency)})
    end

    for _, propData in ipairs(displayProps) do
        local propRow = createInstance("Frame", {
            Size = UDim2.new(1, 0, 0, 18),
            BackgroundColor3 = Color3.fromRGB(15, 25, 45),
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0
        }, self.PropertiesScroll)

        createInstance("TextLabel", {
            Size = UDim2.new(0.45, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = " " .. propData[1],
            TextColor3 = Color3.fromRGB(100, 160, 220),
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
            TextSize = 12
        }, propRow)

        createInstance("TextLabel", {
            Size = UDim2.new(0.55, 0, 1, 0),
            Position = UDim2.new(0.45, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(propData[2]),
            TextColor3 = Color3.fromRGB(220, 235, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
            TextSize = 12
        }, propRow)
    end
end

